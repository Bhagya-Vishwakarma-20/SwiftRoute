# --- Postgres (docker service: postgres) ---
POSTGRES_USER=swiftroute
POSTGRES_PASSWORD=swiftroute
POSTGRES_DB=swiftroute

# Host-facing URLs (used by `npm run dev` and `npx prisma migrate deploy`).
# Inside docker-compose the app containers get service-name URLs instead.
DATABASE_URL=postgresql://swiftroute:swiftroute@localhost:5432/swiftroute?schema=public
REDIS_URL=redis://localhost:6379
AMQP_URL=amqp://guest:guest@localhost:5672

# --- App ---
JWT_SECRET=
CURRENT_URL=http://localhost:3000

# --- New Relic ingest license keys (optional) ---
NEWRELIC_LICENSE=
NEWRELIC_LICENSE_2=
